<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Carvis.App.ViewModels"
        xmlns:storage="using:Carvis.Core.Storage"
        x:Class="Carvis.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Ajustes de Carvis"
        Icon="/Assets/carvis.ico"
        Width="760" Height="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}"
        FontFamily="{StaticResource CarvisFont}">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerStrong}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelAlt}" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
        <Button Grid.Column="1" Content="Cerrar" Margin="8,0" Click="OnCloseClick" />
        <Button Grid.Column="2" Classes="primary" Content="Guardar" Command="{Binding SaveCommand}" />
      </Grid>
    </Border>

    <TabControl TabStripPlacement="Left" Padding="20,8">
      <TabItem Header="General">
        <ScrollViewer>
          <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Classes="section" Text="General" />
            <TextBlock Classes="label" Text="Cómo quieres que te llame" />
            <TextBox Text="{Binding Draft.Assistant.UserName}" Watermark="Tu nombre (si lo dejas vacío uso el de Windows)" />

            <TextBlock Classes="label" Text="Atajo para mostrar u ocultar Carvis" />
            <TextBox Text="{Binding Draft.Hotkey.ToggleWindow}" Watermark="Alt+Space" />
            <TextBlock Classes="hint" Text="Ctrl, Alt, Shift o Win + una tecla. Ejemplos: Alt+Space, Ctrl+Shift+J, Win+F1. Si no funciona, puede que otro programa (PowerToys...) lo esté usando." />

            <TextBlock Classes="label" Text="Tipo de ventana" />
            <ComboBox ItemsSource="{Binding WindowModes}" SelectedIndex="{Binding WindowMode}" HorizontalAlignment="Stretch" />

            <TextBlock Classes="label" Text="Tema" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}" HorizontalAlignment="Stretch" />

            <TextBlock Classes="label" Text="Color de acento" />
            <ItemsControl ItemsSource="{Binding AccentColors}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Classes="swatch" Margin="0,0,6,0" Padding="0" MinWidth="0" Background="Transparent"
                          Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).SetAccentCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding, StringFormat='Color de acento {0}'}" ToolTip.Tip="{Binding}">
                    <Border Width="22" Height="22" CornerRadius="11" BorderThickness="2" BorderBrush="{DynamicResource CardBorder}"
                            Background="{Binding, Converter={x:Static vm:SettingsViewModel.AccentToBrush}}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="hint" Text="{Binding AccentText}" />
            <CheckBox Content="Animaciones" IsChecked="{Binding Draft.Window.Animations}" />

            <TextBlock Classes="label" Text="Fondo" />
            <ComboBox ItemsSource="{Binding Backdrops}" SelectedItem="{Binding Draft.Window.Backdrop}" HorizontalAlignment="Stretch" />
            <TextBlock Classes="hint" Text="Acrylic y Mica son translúcidos (Windows 11). Solid se lee mejor." />

            <TextBlock Classes="label" Text="Tamaño de letra" />
            <NumericUpDown Value="{Binding Draft.Window.FontSize}" Minimum="10" Maximum="28" Increment="1" FormatString="0" />

            <CheckBox Content="Iniciar con Windows (oculto en la bandeja)" IsChecked="{Binding StartWithWindows}" IsVisible="{Binding IsWindows}" />
            <CheckBox Content="Arrancar oculto en la bandeja" IsChecked="{Binding Draft.Window.StartHidden}" />
            <CheckBox Content="Recordar la posición y el tamaño de la ventana" IsChecked="{Binding Draft.Window.RememberPosition}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Modelo">
        <ScrollViewer>
          <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Classes="section" Text="Modelo de IA (Ollama)" />
            <TextBlock Classes="label" Text="Dirección de Ollama" />
            <TextBox Text="{Binding Draft.Ollama.BaseUrl}" />

            <TextBlock Classes="label" Text="Modelo de chat" />
            <AutoCompleteBox Text="{Binding Draft.Ollama.ChatModel}" ItemsSource="{Binding InstalledModels}" FilterMode="Contains" MinimumPrefixLength="0" />
            <TextBlock Classes="label" Text="Modelo de embeddings (documentos)" />
            <AutoCompleteBox Text="{Binding Draft.Ollama.EmbeddingModel}" ItemsSource="{Binding InstalledModels}" FilterMode="Contains" MinimumPrefixLength="0" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
              <Button Content="Descargar modelo de chat" Command="{Binding DownloadModelCommand}" CommandParameter="{Binding Draft.Ollama.ChatModel}" />
              <Button Content="Descargar embeddings" Command="{Binding DownloadModelCommand}" CommandParameter="{Binding Draft.Ollama.EmbeddingModel}" />
            </StackPanel>
            <ProgressBar Value="{Binding DownloadProgress}" IsVisible="{Binding IsDownloading}" Margin="0,8,0,0" />
            <TextBlock Classes="hint" Text="{Binding DownloadStatus}" />

            <TextBlock Classes="label" Text="Ventana de contexto (tokens)" />
            <NumericUpDown Value="{Binding Draft.Ollama.ContextLength}" Minimum="2048" Maximum="131072" Increment="2048" FormatString="0" />
            <TextBlock Classes="hint" Text="Más contexto recuerda conversaciones más largas pero usa más memoria de la GPU. 16384 va bien con 12 GB." />

            <TextBlock Classes="label" Text="{Binding Draft.Ollama.Temperature, StringFormat='Creatividad: {0:0.0}'}" />
            <Slider Value="{Binding Draft.Ollama.Temperature}" Minimum="0" Maximum="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True" />

            <CheckBox Content="Pensar antes de responder (qwen3, más lento)" IsChecked="{Binding Draft.Ollama.EnableThinking}" />

            <TextBlock Classes="label" Text="Mantener el modelo cargado" />
            <TextBox Text="{Binding Draft.Ollama.KeepAlive}" />
            <TextBlock Classes="hint" Text="Ejemplos: 30m, 2h, -1 (siempre). Mientras está cargado, la primera respuesta es inmediata." />

            <TextBlock Classes="label" Text="{Binding Draft.Ollama.ToolTemperature, StringFormat='Precisión al usar herramientas: {0:0.0}'}" />
            <Slider Value="{Binding Draft.Ollama.ToolTemperature}" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" />
            <TextBlock Classes="hint" Text="Valores bajos hacen que rellene los argumentos de las acciones con más cuidado." />
            <TextBlock Classes="label" Text="{Binding Draft.Ollama.TopP, StringFormat='top_p: {0:0.00}'}" />
            <Slider Value="{Binding Draft.Ollama.TopP}" Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />

            <TextBlock Classes="section" Text="Rendimiento de la gráfica" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Flash attention y la caché KV de 8 bits reducen mucho la memoria que gasta el contexto. Son ajustes de Ollama: se aplican al reiniciarlo." />
            <TextBlock Text="{Binding OllamaTuningStatus}" TextWrapping="Wrap" Margin="0,4" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Optimizar Ollama" Command="{Binding OptimizeOllamaCommand}" />
              <Button Content="Quitar" Command="{Binding ResetOllamaTuningCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Asistente">
        <ScrollViewer>
          <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Classes="section" Text="Comportamiento" />
            <TextBlock Classes="label" Text="Instrucciones para Carvis" />
            <TextBox Text="{Binding Draft.Assistant.SystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
            <CheckBox Content="Permitir que Carvis actúe en el PC (herramientas)" IsChecked="{Binding Draft.Assistant.EnableTools}" />
            <TextBlock Classes="label" Text="Pasos máximos por respuesta" />
            <NumericUpDown Value="{Binding Draft.Assistant.MaxToolSteps}" Minimum="1" Maximum="20" FormatString="0" />
            <TextBlock Classes="label" Text="Mensajes de la conversación que se envían al modelo" />
            <NumericUpDown Value="{Binding Draft.Assistant.MaxHistoryMessages}" Minimum="4" Maximum="200" FormatString="0" />
            <TextBlock Classes="hint" Text="Lo más antiguo se resume automáticamente para que no se pierda." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Voz y pantalla">
        <ScrollViewer>
          <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Classes="section" Text="Hablar con Carvis" />
            <CheckBox Content="Activar la voz" IsChecked="{Binding Draft.Voice.Enabled}" />
            <TextBlock Classes="hint" Text="Todo se procesa en tu PC: Whisper entiende lo que dices y Piper pone la voz. Solo se conecta a Internet para descargar los modelos cuando pulses el botón." />

            <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="12" Margin="0,10,0,0">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding VoiceStatus}" TextWrapping="Wrap" />
                <ProgressBar Value="{Binding VoiceDownloadProgress}" Maximum="100" IsVisible="{Binding IsDownloadingVoice}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Descargar modelos de voz" Command="{Binding DownloadVoiceModelsCommand}" />
                  <Button Content="Cancelar" Command="{Binding CancelVoiceDownloadCommand}" IsVisible="{Binding IsDownloadingVoice}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Classes="label" Text="Atajo para hablar" />
            <TextBox Text="{Binding Draft.Voice.PushToTalkHotkey}" Watermark="Ctrl+Alt+Space" />
            <TextBlock Classes="hint" Text="Púlsalo, habla y calla: Carvis entiende que has terminado. Púlsalo otra vez mientras habla Carvis para cortarle." />

            <TextBlock Classes="label" Text="Precisión del reconocimiento (Whisper)" />
            <ComboBox ItemsSource="{Binding WhisperSizes}" SelectedItem="{Binding Draft.Voice.WhisperModel}" HorizontalAlignment="Stretch" />
            <TextBlock Classes="hint" Text="tiny y base son rápidos pero fallan más; small va bien en español; medium es el más preciso (unos 1,5 GB y 2 GB de VRAM)." />
            <CheckBox Content="Usar la tarjeta gráfica (Vulkan)" IsChecked="{Binding Draft.Voice.UseGpu}" />

            <TextBlock Classes="label" Text="Micrófono" />
            <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" HorizontalAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Button Content="Probar micrófono" Command="{Binding TestMicrophoneCommand}" />
              <ProgressBar Value="{Binding MicrophoneLevel}" Maximum="100" Width="200" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Classes="label" Text="Altavoces" />
            <ComboBox ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker}" HorizontalAlignment="Stretch" />

            <CheckBox Content="Leer en voz alta las respuestas a lo que pregunto hablando" IsChecked="{Binding Draft.Voice.SpeakAnswers}" />
            <TextBlock Classes="label" Text="Voz de Piper" />
            <TextBox Text="{Binding Draft.Voice.PiperVoice}" Watermark="es_ES-davefx-medium" />
            <TextBlock Classes="hint" Text="Otras voces en español: es_ES-sharvard-medium, es_MX-claude-high. Al cambiarla, vuelve a pulsar «Descargar modelos de voz»." />
            <TextBlock Classes="label" Text="Velocidad de la voz" />
            <Slider Minimum="0.6" Maximum="1.6" Value="{Binding Draft.Voice.SpeechRate}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
            <Button Content="Probar la voz" Command="{Binding TestSpeakerCommand}" />

            <TextBlock Classes="label" Text="Pausa que indica que has terminado (ms)" />
            <NumericUpDown Value="{Binding Draft.Voice.SilenceMilliseconds}" Minimum="300" Maximum="3000" Increment="100" FormatString="0" />

            <CheckBox Content="Escuchar siempre la palabra «Carvis»" IsChecked="{Binding Draft.Voice.WakeWord}" />
            <TextBlock Classes="hint" Text="El micrófono queda abierto y Carvis solo reacciona si empiezas con «Carvis…». Nunca escucha con el PC bloqueado. Usa algo más de CPU." />
            <CheckBox Content="Conversación continua (después de contestar, vuelve a escuchar)" IsChecked="{Binding Draft.Voice.ContinuousConversation}" />
            <CheckBox Content="Cortar a Carvis si hablo mientras habla (mejor con auriculares)" IsChecked="{Binding Draft.Voice.InterruptByVoice}" />

            <TextBlock Classes="section" Text="Capturas de pantalla" />
            <TextBlock Classes="label" Text="Atajo para capturar una zona y preguntar sobre ella" />
            <TextBox Text="{Binding Draft.Vision.CaptureHotkey}" Watermark="Ctrl+Alt+S" />
            <TextBlock Classes="label" Text="Modelo de visión" />
            <TextBox Text="{Binding Draft.Ollama.VisionModel}" Watermark="qwen2.5vl:7b" />
            <CheckBox Content="Guardar las capturas en Imágenes\Carvis" IsChecked="{Binding Draft.Vision.SaveCaptures}" />
            <TextBlock Classes="hint" Text="Si no lo marcas, las capturas solo existen en memoria mientras las usas." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Permisos">
        <ScrollViewer>
          <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Classes="section" Text="Qué puede hacer Carvis" />
            <CheckBox Content="Preguntarme antes de crear, mover o renombrar archivos" IsChecked="{Binding Draft.Permissions.ConfirmChanges}" />
            <CheckBox Content="Preguntarme también antes de abrir programas o páginas web" IsChecked="{Binding Draft.Permissions.ConfirmLowRisk}" />
            <TextBlock Classes="hint" Text="Borrar, sobrescribir, ejecutar scripts o apagar el PC siempre se confirma." />
            <CheckBox Content="Permitir herramientas que usan Internet (tiempo, divisas, búsqueda web)" IsChecked="{Binding Draft.Permissions.AllowInternet}" />
            <CheckBox Content="Cargar plugins de %AppData%\Carvis\plugins (solo si confías en ellos)" IsChecked="{Binding Draft.Permissions.EnablePlugins}" />
            <TextBlock Classes="hint" Text="Un plugin puede hacer cualquier cosa con tus permisos. Se cargan al reiniciar Carvis." />
            <TextBlock Classes="label" Text="Buscador web (SearXNG, opcional)" />
            <TextBox Text="{Binding Draft.Permissions.SearchUrl}" Watermark="http://localhost:8080" IsEnabled="{Binding Draft.Permissions.AllowInternet}" />
            <TextBlock Classes="hint" Text="Para que Carvis lea resultados de búsqueda hace falta un SearXNG propio. Sin él, solo abre la búsqueda en el navegador." />

            <TextBlock Classes="label" Text="Carpetas en las que puede trabajar" />
            <TextBlock Classes="hint" Text="Si la lista está vacía, puede trabajar en toda tu carpeta personal (excepto AppData). Nunca toca Windows ni Archivos de programa." />
            <ItemsControl ItemsSource="{Binding AllowedFolders}" Margin="0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="Quitar"
                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveAllowedFolderCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Añadir carpeta…" Click="OnAddAllowedFolderClick" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Documentos">
        <ScrollViewer>
          <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Classes="section" Text="Tus documentos" />
            <TextBlock Classes="hint" Text="Carvis lee los documentos de estas carpetas (PDF, Word, Excel, PowerPoint, texto...) para responder preguntas sobre ellos citando de dónde saca cada dato. Todo se queda en tu PC." />
            <ItemsControl ItemsSource="{Binding DocumentFolders}" Margin="0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="Quitar"
                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveDocumentFolderCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Añadir carpeta…" Click="OnAddDocumentFolderClick" />
            <TextBlock Classes="label" Text="{Binding IndexStatus}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Indexar ahora" Command="{Binding IndexNowCommand}" />
              <Button Content="Pausar" Command="{Binding PauseIndexCommand}" />
              <Button Content="Vaciar índice" Command="{Binding ClearIndexCommand}" />
            </StackPanel>
            <CheckBox Content="Actualizar el índice cuando cambien los archivos" IsChecked="{Binding Draft.Documents.WatchChanges}" />
            <TextBlock Classes="label" Text="Tamaño máximo por archivo (MB)" />
            <NumericUpDown Value="{Binding Draft.Documents.MaxFileSizeMb}" Minimum="1" Maximum="500" FormatString="0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Memoria">
        <ScrollViewer>
          <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Classes="section" Text="Lo que Carvis recuerda de ti" />
            <TextBlock Classes="hint" Text="Se guarda cuando le cuentas algo o le pides que lo recuerde. Puedes borrar lo que quieras." />
            <ItemsControl ItemsSource="{Binding Memories}" Margin="0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="storage:MemoryItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Olvidar" Margin="8,0,0,0"
                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).DeleteMemoryCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Olvidarlo todo" Command="{Binding ClearMemoriesCommand}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Privacidad">
        <ScrollViewer>
          <StackPanel MaxWidth="520" HorizontalAlignment="Left" Spacing="4">
            <TextBlock Classes="section" Text="Privacidad y datos" />
            <TextBlock Classes="hint" Text="Todo funciona en tu PC: Carvis no envía nada a Internet salvo que actives las herramientas que lo necesitan." />
            <CheckBox Content="Guardar las conversaciones para poder volver a ellas" IsChecked="{Binding Draft.Privacy.SaveConversations}" />
            <CheckBox Content="Cifrar conversaciones y recuerdos con mi cuenta de Windows" IsChecked="{Binding Draft.Privacy.EncryptData}" />
            <CheckBox Content="Incluir el contenido de los mensajes en el log (solo para depurar)" IsChecked="{Binding Draft.Logging.IncludeContent}" />
            <CheckBox Content="Buscar actualizaciones en GitHub una vez al día" IsChecked="{Binding Draft.Privacy.CheckForUpdates}" />
            <TextBlock Classes="hint" Text="Solo se descarga la lista de versiones y, si hay una nueva, la actualización. No se envía nada tuyo." />
            <TextBlock Classes="label" Text="{Binding DataFolder, StringFormat='Tus datos están en {0}'}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Abrir carpeta de datos" Command="{Binding OpenDataFolderCommand}" />
              <Button Content="Abrir logs" Command="{Binding OpenLogsCommand}" />
            </StackPanel>
            <Button Classes="danger" Content="{Binding DeleteDataLabel}" Command="{Binding DeleteAllDataCommand}" Margin="0,16,0,0" />
            <Button Content="Restablecer los ajustes de fábrica" Command="{Binding ResetToDefaultsCommand}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Acerca de">
        <StackPanel Spacing="8" MaxWidth="520" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Image Source="/Assets/carvis.png" Width="48" Height="48" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Carvis" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Version, StringFormat='Versión {0}'}" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="hint" Text="Asistente de IA local para Windows. Usa modelos que se ejecutan en tu PC con Ollama." />
          <HyperlinkButton Content="Código en GitHub" NavigateUri="https://github.com/carvima07eng-dot/Carvis" />
          <HyperlinkButton Content="Ollama" NavigateUri="https://ollama.com" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
