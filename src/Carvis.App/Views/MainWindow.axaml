<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Carvis.App.ViewModels"
        xmlns:controls="using:Carvis.App.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="420"
        x:Class="Carvis.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Carvis"
        Icon="/Assets/carvis.ico"
        Width="760" MaxHeight="560"
        SizeToContent="Height"
        SystemDecorations="None"
        CanResize="False"
        CanMaximize="False"
        ShowInTaskbar="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontFamily="{StaticResource CarvisFont}">

  <Window.Styles>
    <!-- Prompt box without the default Fluent chrome -->
    <Style Selector="TextBox.prompt">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="4,8" />
    </Style>
    <Style Selector="TextBox.prompt:pointerover /template/ Border#PART_BorderElement,
                     TextBox.prompt:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.prompt /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <!-- "accent" is taken by Fluent, so the main button uses its own class -->
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="#0B1220" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#67E8F9" />
      <Setter Property="Foreground" Value="#0B1220" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#06B6D4" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#16313A" />
      <Setter Property="Foreground" Value="#4B6470" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Button.caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Border.bubble">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="MaxWidth" Value="640" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{StaticResource Surface}" />
    </Style>
    <Style Selector="Border.bubble.user">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="#1E3A5F" />
    </Style>
    <Style Selector="Border.bubble.error">
      <Setter Property="Background" Value="#3A1D24" />
      <Setter Property="BorderBrush" Value="#F87171" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Ellipse.status">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="#F87171" />
    </Style>
    <Style Selector="Ellipse.status.ready">
      <Setter Property="Fill" Value="#34D399" />
    </Style>
    <Style Selector="Ellipse.status.checking">
      <Setter Property="Fill" Value="#9CA3AF" />
    </Style>
  </Window.Styles>

  <Border Background="{StaticResource Background}"
          BorderBrush="#2A3A4F" BorderThickness="1"
          CornerRadius="18" Margin="8"
          BoxShadow="0 10 30 0 #66000000"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

      <!-- Title bar: drag to move -->
      <Grid x:Name="TitleBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto"
            Background="Transparent" Margin="16,8,8,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="/Assets/carvis.png" Width="18" Height="18" />
          <TextBlock Text="Carvis" FontWeight="SemiBold" FontSize="13"
                     Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="2" Classes="caption" Content="—"
                ToolTip.Tip="Minimizar" Click="OnMinimizeClick" />
        <Button Grid.Column="3" Classes="caption" Content="✕"
                ToolTip.Tip="Ocultar en la bandeja del sistema" Click="OnHideClick" />
      </Grid>

      <!-- Prompt -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="18,4,12,12">
        <TextBox x:Name="PromptBox" Grid.Column="0" Classes="prompt" Margin="0,0,10,0"
                 Watermark="Pregúntale algo a Carvis…"
                 Text="{Binding Input}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap" MaxHeight="120" />
        <Panel Grid.Column="1" VerticalAlignment="Center">
          <Button Classes="primary" Content="Enviar"
                  Command="{Binding SendCommand}"
                  IsVisible="{Binding !IsBusy}" />
          <Button Classes="primary" Content="Detener"
                  Command="{Binding CancelCommand}"
                  IsVisible="{Binding IsBusy}" />
        </Panel>
      </Grid>

      <!-- Ollama / hotkey problems -->
      <StackPanel Grid.Row="2" Spacing="6" Margin="18,0,18,12">
        <Border Background="#3A2A12" BorderBrush="#F59E0B" BorderThickness="1"
                CornerRadius="10" Padding="12,10"
                IsVisible="{Binding HasStatusMessage}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                         Foreground="#FDE68A" />
              <SelectableTextBlock Text="{Binding StatusCommand}"
                                   IsVisible="{Binding HasStatusCommand}"
                                   FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                   Foreground="{StaticResource TextPrimary}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="Reintentar"
                    VerticalAlignment="Center"
                    Command="{Binding CheckStatusCommand}" />
          </Grid>
        </Border>
        <TextBlock Text="{Binding HotkeyWarning}" IsVisible="{Binding HasHotkeyWarning}"
                   TextWrapping="Wrap" Foreground="#FCA5A5" FontSize="12" />
      </StackPanel>

      <!-- Conversation -->
      <Border Grid.Row="3" BorderBrush="#1F2A3A" BorderThickness="0,1,0,0"
              IsVisible="{Binding HasMessages}">
        <ScrollViewer x:Name="MessagesScroll" MaxHeight="380"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Messages}" Margin="18,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MessageViewModel">
                <Border Classes="bubble"
                        Classes.user="{Binding IsUser}"
                        Classes.error="{Binding IsError}">
                  <StackPanel Spacing="4">
                    <SelectableTextBlock Text="{Binding Content}" IsVisible="{Binding IsUser}"
                                         TextWrapping="Wrap" FontSize="14" LineHeight="21"
                                         Foreground="{StaticResource TextPrimary}" />
                    <controls:MarkdownView Markdown="{Binding Content}" IsVisible="{Binding !IsUser}" />
                    <TextBlock Text="Pensando…" IsVisible="{Binding IsWaiting}"
                               FontStyle="Italic" Foreground="{StaticResource TextMuted}" />
                    <Button Classes="ghost" Content="{Binding CopyLabel}"
                            IsVisible="{Binding CanCopy}"
                            HorizontalAlignment="Right" Margin="0,0,-8,-6"
                            Padding="8,2" FontSize="11"
                            Click="OnCopyMessageClick" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Footer -->
      <Border Grid.Row="4" Background="#0DFFFFFF" Padding="18,6,10,6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Classes="status"
                     Classes.ready="{Binding IsOllamaReady}"
                     Classes.checking="{Binding IsCheckingStatus}" />
            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}">
              <Run Text="{Binding ModelName}" />
              <Run Text=" · " />
              <Run Text="{Binding ConnectionText}" />
            </TextBlock>
          </StackPanel>
          <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource TextMuted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
            <Run Text="Enter enviar · Shift+Enter nueva línea · " />
            <Run Text="{Binding DismissHint}" />
            <Run Text=" · " />
            <Run Text="{Binding HotkeyText}" />
          </TextBlock>
          <Button Grid.Column="2" Classes="ghost" Content="Nueva conversación"
                  Command="{Binding NewConversationCommand}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
