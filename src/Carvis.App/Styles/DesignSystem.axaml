<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:p="using:Carvis.App.Platform">
  <!--
    Carvis design system: the only place with colours, spacing, radii, shadows, fonts and timings.
    Views use these keys; a test fails if a view uses a literal colour, margin, padding, spacing,
    radius or font size. Colours follow the Windows 11 palette for each theme.
  -->

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="Background" Color="#202020" /> <!-- Window base when there is no Mica -->
        <SolidColorBrush x:Key="Layer" Color="#00000000" /> <!-- Window base over Mica (Mica shows through) -->
        <SolidColorBrush x:Key="Surface" Color="#0DFFFFFF" /> <!-- Cards and the prompt -->
        <SolidColorBrush x:Key="SurfaceSolid" Color="#2C2C2C" /> <!-- Pop-ups, toasts, menus -->
        <SolidColorBrush x:Key="SubtleHover" Color="#0FFFFFFF" /> <!-- Hover on subtle buttons and rows -->
        <SolidColorBrush x:Key="SubtlePressed" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="Stroke" Color="#14FFFFFF" /> <!-- Card and control borders -->
        <SolidColorBrush x:Key="StrokeStrong" Color="#2EFFFFFF" /> <!-- Dividers, window border -->
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#C8FFFFFF" />
        <SolidColorBrush x:Key="TextTertiary" Color="#8BFFFFFF" /> <!-- Hints, placeholders -->
        <SolidColorBrush x:Key="TextDisabled" Color="#5DFFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#60CDFF" /> <!-- Overridden by the Windows or user accent -->
        <SolidColorBrush x:Key="AccentHover" Color="#E660CDFF" />
        <SolidColorBrush x:Key="AccentPressed" Color="#CC60CDFF" />
        <SolidColorBrush x:Key="AccentDisabled" Color="#28FFFFFF" />
        <SolidColorBrush x:Key="OnAccent" Color="#000000" /> <!-- Text on accent fills -->
        <SolidColorBrush x:Key="AccentText" Color="#99EBFF" /> <!-- Links -->
        <SolidColorBrush x:Key="AccentSubtle" Color="#2660CDFF" /> <!-- User messages, selection -->
        <SolidColorBrush x:Key="Success" Color="#6CCB5F" />
        <SolidColorBrush x:Key="SuccessSubtle" Color="#393D1B" />
        <SolidColorBrush x:Key="Danger" Color="#FF99A4" />
        <SolidColorBrush x:Key="OnDanger" Color="#000000" />
        <SolidColorBrush x:Key="DangerSubtle" Color="#442726" />
        <SolidColorBrush x:Key="Warning" Color="#FCE100" />
        <SolidColorBrush x:Key="WarningSubtle" Color="#433519" />
        <SolidColorBrush x:Key="InfoSubtle" Color="#1A60CDFF" />
        <SolidColorBrush x:Key="Skeleton" Color="#14FFFFFF" /> <!-- Loading placeholders -->
        <SolidColorBrush x:Key="CodeBackground" Color="#33000000" />
        <SolidColorBrush x:Key="InlineCode" Color="#FFB2CC" />
        <SolidColorBrush x:Key="CodeKeyword" Color="#C9A2FF" />
        <SolidColorBrush x:Key="CodeString" Color="#A8DB8F" />
        <SolidColorBrush x:Key="CodeComment" Color="#8BFFFFFF" />
        <SolidColorBrush x:Key="CodeNumber" Color="#FFB07A" />
        <SolidColorBrush x:Key="CodeType" Color="#7FC8FF" />
        <SolidColorBrush x:Key="Scrim" Color="#99000000" /> <!-- Dims the screen around a capture -->
        <BoxShadows x:Key="Shadow.Card">0 2 4 0 #26000000</BoxShadows>
        <BoxShadows x:Key="Shadow.Flyout">0 8 16 0 #47000000</BoxShadows>
        <BoxShadows x:Key="Shadow.Window">0 8 32 0 #66000000</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="Background" Color="#F3F3F3" />
        <SolidColorBrush x:Key="Layer" Color="#00FFFFFF" />
        <SolidColorBrush x:Key="Surface" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="SurfaceSolid" Color="#F9F9F9" />
        <SolidColorBrush x:Key="SubtleHover" Color="#09000000" />
        <SolidColorBrush x:Key="SubtlePressed" Color="#06000000" />
        <SolidColorBrush x:Key="Stroke" Color="#0F000000" />
        <SolidColorBrush x:Key="StrokeStrong" Color="#29000000" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E4000000" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9E000000" />
        <SolidColorBrush x:Key="TextTertiary" Color="#72000000" />
        <SolidColorBrush x:Key="TextDisabled" Color="#5C000000" />
        <SolidColorBrush x:Key="Accent" Color="#005FB8" />
        <SolidColorBrush x:Key="AccentHover" Color="#E6005FB8" />
        <SolidColorBrush x:Key="AccentPressed" Color="#CC005FB8" />
        <SolidColorBrush x:Key="AccentDisabled" Color="#37000000" />
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentText" Color="#003E92" />
        <SolidColorBrush x:Key="AccentSubtle" Color="#1A005FB8" />
        <SolidColorBrush x:Key="Success" Color="#0F7B0F" />
        <SolidColorBrush x:Key="SuccessSubtle" Color="#DFF6DD" />
        <SolidColorBrush x:Key="Danger" Color="#C42B1C" />
        <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DangerSubtle" Color="#FDE7E9" />
        <SolidColorBrush x:Key="Warning" Color="#9D5D00" />
        <SolidColorBrush x:Key="WarningSubtle" Color="#FFF4CE" />
        <SolidColorBrush x:Key="InfoSubtle" Color="#F2F6FC" />
        <SolidColorBrush x:Key="Skeleton" Color="#0F000000" />
        <SolidColorBrush x:Key="CodeBackground" Color="#08000000" />
        <SolidColorBrush x:Key="InlineCode" Color="#B4009E" />
        <SolidColorBrush x:Key="CodeKeyword" Color="#8A2BE2" />
        <SolidColorBrush x:Key="CodeString" Color="#0F7B0F" />
        <SolidColorBrush x:Key="CodeComment" Color="#72000000" />
        <SolidColorBrush x:Key="CodeNumber" Color="#B54D00" />
        <SolidColorBrush x:Key="CodeType" Color="#005FB8" />
        <SolidColorBrush x:Key="Scrim" Color="#66000000" />
        <BoxShadows x:Key="Shadow.Card">0 2 4 0 #14000000</BoxShadows>
        <BoxShadows x:Key="Shadow.Flyout">0 8 16 0 #24000000</BoxShadows>
        <BoxShadows x:Key="Shadow.Window">0 8 32 0 #33000000</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static p:ThemeColors.HighContrast}">
        <SolidColorBrush x:Key="Background" Color="#000000" />
        <SolidColorBrush x:Key="Layer" Color="#000000" />
        <SolidColorBrush x:Key="Surface" Color="#000000" />
        <SolidColorBrush x:Key="SurfaceSolid" Color="#000000" />
        <SolidColorBrush x:Key="SubtleHover" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="SubtlePressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Stroke" Color="#FFFFFF" />
        <SolidColorBrush x:Key="StrokeStrong" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextTertiary" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TextDisabled" Color="#A6A6A6" />
        <SolidColorBrush x:Key="Accent" Color="#FFFF00" />
        <SolidColorBrush x:Key="AccentHover" Color="#FFFF80" />
        <SolidColorBrush x:Key="AccentPressed" Color="#C8C800" />
        <SolidColorBrush x:Key="AccentDisabled" Color="#3F3F3F" />
        <SolidColorBrush x:Key="OnAccent" Color="#000000" />
        <SolidColorBrush x:Key="AccentText" Color="#FFFF00" />
        <SolidColorBrush x:Key="AccentSubtle" Color="#000000" />
        <SolidColorBrush x:Key="Success" Color="#00FF00" />
        <SolidColorBrush x:Key="SuccessSubtle" Color="#000000" />
        <SolidColorBrush x:Key="Danger" Color="#FF6060" />
        <SolidColorBrush x:Key="OnDanger" Color="#000000" />
        <SolidColorBrush x:Key="DangerSubtle" Color="#000000" />
        <SolidColorBrush x:Key="Warning" Color="#FFFF00" />
        <SolidColorBrush x:Key="WarningSubtle" Color="#000000" />
        <SolidColorBrush x:Key="InfoSubtle" Color="#000000" />
        <SolidColorBrush x:Key="Skeleton" Color="#3F3F3F" />
        <SolidColorBrush x:Key="CodeBackground" Color="#000000" />
        <SolidColorBrush x:Key="InlineCode" Color="#00FFFF" />
        <SolidColorBrush x:Key="CodeKeyword" Color="#FFFF00" />
        <SolidColorBrush x:Key="CodeString" Color="#00FF00" />
        <SolidColorBrush x:Key="CodeComment" Color="#C0C0C0" />
        <SolidColorBrush x:Key="CodeNumber" Color="#FF80FF" />
        <SolidColorBrush x:Key="CodeType" Color="#00FFFF" />
        <SolidColorBrush x:Key="Scrim" Color="#CC000000" />
        <BoxShadows x:Key="Shadow.Card">0 0 0 0 #00000000</BoxShadows>
        <BoxShadows x:Key="Shadow.Flyout">0 0 0 0 #00000000</BoxShadows>
        <BoxShadows x:Key="Shadow.Window">0 0 0 0 #00000000</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Spacing: 4 px scale -->
  <x:Double x:Key="Space.4">4</x:Double>
  <x:Double x:Key="Space.8">8</x:Double>
  <x:Double x:Key="Space.12">12</x:Double>
  <x:Double x:Key="Space.16">16</x:Double>
  <x:Double x:Key="Space.24">24</x:Double>
  <x:Double x:Key="Space.32">32</x:Double>
  <Thickness x:Key="Inset.4">4</Thickness>
  <Thickness x:Key="Inset.8">8</Thickness>
  <Thickness x:Key="Inset.12">12</Thickness>
  <Thickness x:Key="Inset.16">16</Thickness>
  <Thickness x:Key="Inset.24">24</Thickness>
  <Thickness x:Key="Inset.H4V0">4,0</Thickness>
  <Thickness x:Key="Inset.H8V0">8,0</Thickness>
  <Thickness x:Key="Inset.H8V4">8,4</Thickness>
  <Thickness x:Key="Inset.H12V4">12,4</Thickness>
  <Thickness x:Key="Inset.H12V8">12,8</Thickness>
  <Thickness x:Key="Inset.H16V8">16,8</Thickness>
  <Thickness x:Key="Inset.H16V12">16,12</Thickness>
  <Thickness x:Key="Inset.H24V16">24,16</Thickness>
  <Thickness x:Key="Inset.H32V24">32,24</Thickness>
  <Thickness x:Key="Inset.H16V0">16,0</Thickness>
  <Thickness x:Key="Inset.H0V4">0,4</Thickness>
  <Thickness x:Key="Inset.H0V8">0,8</Thickness>
  <Thickness x:Key="Gap.T4">0,4,0,0</Thickness>
  <Thickness x:Key="Gap.T8">0,8,0,0</Thickness>
  <Thickness x:Key="Gap.T12">0,12,0,0</Thickness>
  <Thickness x:Key="Gap.T16">0,16,0,0</Thickness>
  <Thickness x:Key="Gap.T24">0,24,0,0</Thickness>
  <Thickness x:Key="Gap.B4">0,0,0,4</Thickness>
  <Thickness x:Key="Gap.B8">0,0,0,8</Thickness>
  <Thickness x:Key="Gap.B12">0,0,0,12</Thickness>
  <Thickness x:Key="Gap.B16">0,0,0,16</Thickness>
  <Thickness x:Key="Gap.L8">8,0,0,0</Thickness>
  <Thickness x:Key="Gap.L12">12,0,0,0</Thickness>
  <Thickness x:Key="Gap.L32">32,0,0,0</Thickness>
  <Thickness x:Key="Gap.UnderIcon">44,0,0,0</Thickness> <!-- lines up with text next to a 32 px icon tile (32 + 12) -->
  <Thickness x:Key="Gap.R4">0,0,4,0</Thickness>
  <Thickness x:Key="Gap.R8">0,0,8,0</Thickness>
  <Thickness x:Key="Gap.Prompt">16,0,16,12</Thickness>
  <Thickness x:Key="Gap.Content">16,0,16,16</Thickness>
  <Thickness x:Key="Gap.Footer">16,8,12,8</Thickness>
  <Thickness x:Key="Gap.TitleBar">16,4,8,0</Thickness>
  <Thickness x:Key="Gap.Window">8</Thickness>
  <Thickness x:Key="Border.1">1</Thickness>
  <Thickness x:Key="Border.2">2</Thickness>
  <Thickness x:Key="Border.Top1">0,1,0,0</Thickness>
  <Thickness x:Key="Border.Bottom1">0,0,0,1</Thickness>
  <Thickness x:Key="Border.Left3">3,0,0,0</Thickness>

  <!-- Corner radii -->
  <CornerRadius x:Key="Radius.4">4</CornerRadius>
  <CornerRadius x:Key="Radius.8">8</CornerRadius>
  <CornerRadius x:Key="Radius.12">12</CornerRadius>
  <CornerRadius x:Key="Radius.Top8">8,8,0,0</CornerRadius>

  <!-- Typography: Segoe UI Variable on Windows 11, Segoe UI on Windows 10, Inter elsewhere. Five sizes. -->
  <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI, fonts:Inter#Inter, $Default</FontFamily>
  <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI, fonts:Inter#Inter, $Default</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
  <x:Double x:Key="Type.Caption">12</x:Double>
  <x:Double x:Key="Type.Body">14</x:Double>
  <x:Double x:Key="Type.BodyLarge">18</x:Double>
  <x:Double x:Key="Type.Subtitle">20</x:Double>
  <x:Double x:Key="Type.Title">28</x:Double>

  <!-- Icons (Fluent UI System Icons, drawn on their 20 px grid) -->
  <x:Double x:Key="Icon.Small">16</x:Double>
  <x:Double x:Key="Icon.Medium">20</x:Double>
  <x:Double x:Key="Icon.Large">32</x:Double>

  <!-- Controls -->
  <x:Double x:Key="Control.Height">32</x:Double>
  <x:Double x:Key="Control.HeightLarge">40</x:Double>
  <x:Double x:Key="Content.MaxWidth">640</x:Double>
  <x:Double x:Key="Field.Width">260</x:Double>
  <x:Double x:Key="Field.MultilineHeight">120</x:Double>
  <x:Double x:Key="Nav.Width">280</x:Double>
  <x:Double x:Key="Settings.MaxWidth">1000</x:Double>
  <x:Double x:Key="Prompt.MaxHeight">160</x:Double>
  <x:Double x:Key="Skeleton.Width">360</x:Double>
  <x:Double x:Key="Toast.Width">360</x:Double>

  <!-- Motion: short and natural; off when Windows or the user turns animations off -->
  <sys:TimeSpan x:Key="Motion.Fast">0:0:0.15</sys:TimeSpan>
  <sys:TimeSpan x:Key="Motion.Normal">0:0:0.2</sys:TimeSpan>
  <sys:TimeSpan x:Key="Motion.Slow">0:0:0.25</sys:TimeSpan>
</ResourceDictionary>
