<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- OllamaSharp ships a source generator for the .NET 10 compiler; we don't use it on .NET 8. -->
    <NoWarn>$(NoWarn);CS9057</NoWarn>

    <Version>1.1.0</Version>
    <Product>Carvis</Product>
    <Company>Carlos Vidal Marín</Company>
    <Authors>Carlos Vidal Marín</Authors>
    <Copyright>© 2026 Carlos Vidal Marín</Copyright>
    <Description>Asistente de IA local para Windows</Description>
    <RepositoryUrl>https://github.com/carvima07eng-dot/Carvis</RepositoryUrl>
  </PropertyGroup>
</Project>
